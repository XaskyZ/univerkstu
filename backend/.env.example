# ─────────────────────────────────────────────────────────────────────────────
# UniverKstu backend — пример переменных окружения.
# Скопируйте в `backend/.env` и заполните своими значениями.
# НИКОГДА не коммитьте настоящий `.env` — он в .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Базовое ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Аутентификация ───────────────────────────────────────────────────────────
# Обязателен: без JWT_SECRET сервер не стартует.
JWT_SECRET=replace-with-a-long-random-string
# Ключ шифрования учётных данных студента (портальные логин/пароль хранятся
# в БД в зашифрованном виде). Обязателен для входа пользователей.
ENCRYPTION_KEY=replace-with-a-32-byte-random-key
# Необязательные тюнинги времени жизни токена/сессии.
JWT_EXPIRES_IN=365d
JWT_COOKIE_TTL_DAYS=365
USER_SESSION_TTL_DAYS=365

# ── База данных (Postgres / Supabase) ────────────────────────────────────────
# Достаточно одной строки подключения. SUPABASE_* — если используете Supabase.
DATABASE_URL=postgres://user:password@host:5432/dbname
SUPABASE_DATABASE_URL=
SUPABASE_DIRECT_URL=
SUPABASE_POOLER_URL=
# Mongo используется только миграционными скриптами; для рантайма не нужен.
MONGODB_URI=

# ── Портал вуза ──────────────────────────────────────────────────────────────
# Приложение логинится в Platonus (platonus.kstu.kz) под учёткой конкретного
# студента (данные берутся из БД). univer.kstu.kz отключён и не используется.
# Эти переменные — опциональные креды для локальной разработки/скриптов.
# Оставьте пустыми, если не нужны.
PLATONUS_USERNAME=
PLATONUS_PASSWORD=

# ── Хранилище файлов (Cloudflare R2, S3-совместимое) ─────────────────────────
# Без R2 загрузка файлов недоступна (остальное приложение работает).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
CLOUDFLARE_ACCOUNT_ID=

# ── Web-push уведомления (VAPID) ─────────────────────────────────────────────
# Сгенерировать: `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Прочее (необязательно) ───────────────────────────────────────────────────
# Список userId (через запятую), скрытых из публичного лидерборда.
LEADERBOARD_EXCLUDED_USER_IDS=
# Аккаунт, которому заводится демо-сид рейтингов преподавателей (для превью).
TEACHER_RATINGS_SEED_USER_ID=
# Автор сид-объявлений доски (скрипты сидинга).
BOARD_SEED_AUTHOR=

# Rate-limit'ы (есть разумные значения по умолчанию, переопределять не обязательно):
# AUTH_LOGIN_RATE_LIMIT_MAX=
# AUTH_LOGIN_RATE_LIMIT_WINDOW_SEC=
# BOARD_POST_RATE_LIMIT_MAX=
# GLOBAL_CHAT_POST_RATE_LIMIT_MAX=
# CHAT_ROOM_POST_RATE_LIMIT_MAX=
