# ─────────────────────────────────────────────────────────────────────────────
# UniverKstu frontend — пример переменных окружения.
# Скопируйте в `frontend/.env.local` и заполните.
# ─────────────────────────────────────────────────────────────────────────────

# Базовый URL бэкенда (Fastify API). Для локальной разработки — адрес,
# на котором поднят backend.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Публичный канонический URL сайта (для SEO/метаданных). Необязательно.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Код подтверждения Google Search Console (необязательно).
GOOGLE_SITE_VERIFICATION=
